# Hippocampus — Enterprise AI Onboarding Mentor & Knowledge Agent
# Validated at runtime by src/lib/env.ts (Zod Schema)

NODE_ENV="development"
PORT="3000"

# Google GenAI SDK (gemini-3.8-flash + gemini-embedding-2-preview)
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# Cloud SQL for PostgreSQL + pgvector
DATABASE_URL="postgresql://postgres:password@localhost:5432/hippocampus"

# Slack Events API HMAC-SHA256 Verification Secret
SLACK_SIGNING_SECRET="YOUR_SLACK_SIGNING_SECRET"

# Optional Upstash Redis REST Credentials for Distributed Rate-Limiting
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Default Workspace RBAC Clearance ('Admin' | 'Manager' | 'Engineer')
DEFAULT_RBAC_ROLE="Admin"

# Phase 4: GitHub OAuth & Webhook Connector (Optional - falls back to public GitHub API + interactive simulator)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GITHUB_WEBHOOK_SECRET=""
GITHUB_PERSONAL_ACCESS_TOKEN=""
APP_URL="https://ais-dev-pnrrnv26eleng4bttsbsvt-389797733259.asia-east1.run.app"

