# =============================================================================
# HIPPOCAMPUS AI — ENVIRONMENT CONFIGURATION TEMPLATE (SANITIZED)
# Never commit real secrets, tokens, or service-account private keys.
# =============================================================================

# Runtime mode: development | test | production
NODE_ENV="development"
PORT="3000"

# Application public URL (included in CORS allowlist and OAuth redirect URIs)
APP_URL="MY_APP_URL"

# Comma-separated explicit production CORS origin allowlist (required in production)
# Example: ALLOWED_ORIGINS="https://hippocampus.company.com,https://console.company.com"
ALLOWED_ORIGINS=""

# Explicit Express trusted reverse-proxy hop count (0 = direct, 1 = single load balancer e.g. Cloud Run)
# Never use blanket trust-all; rate limiting and req.ip rely on this exact hop count.
TRUST_PROXY_HOPS="1"

# Firebase Admin SDK Configuration (server-side ID token verification)
FIREBASE_PROJECT_ID=""
# In production outside GCP/Cloud Run ADC, provide service account via secret manager:
# GOOGLE_APPLICATION_CREDENTIALS="/path/to/service-account.json"
# Or inline JSON via secret manager (never commit real values):
FIREBASE_SERVICE_ACCOUNT_JSON=""

# Least-privilege default role for newly onboarded verified users ONLY.
# Unauthenticated requests NEVER receive a role. Must remain "Engineer".
DEFAULT_RBAC_ROLE="Engineer"

# Optional one-time initial bootstrap Admin allowlist (comma-separated verified emails or UIDs).
# Applies ONLY on initial user creation with email_verified === true; never re-elevates existing users.
# Remove after initial Admin provisioning is completed.
BOOTSTRAP_ADMIN_EMAILS=""
BOOTSTRAP_ADMIN_UIDS=""

# GEMINI_API_KEY: Required for Gemini AI API calls (injected at runtime from secrets)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Cloud SQL PostgreSQL + pgvector Runtime Environment Variables
# Production enforces strict PostgreSQL persistence (fail-closed HTTP 503 if unavailable).
# For TCP connections in production, verified TLS (rejectUnauthorized: true) is enforced;
# supply SQL_SSL_CA_PATH if using a private CA bundle. Cloud SQL Unix sockets (/cloudsql/...) use proxy mTLS.
SQL_HOST="localhost"
SQL_DB_NAME="postgres"
SQL_USER="app_user"
SQL_PASSWORD=""
SQL_ADMIN_USER="postgres"
SQL_ADMIN_PASSWORD=""
SQL_SSL_CA_PATH=""

# Development/test only! Must NEVER be set to "true" in production (server refuses to start in prod if true).
HIPPOCAMPUS_ALLOW_IN_MEMORY_FALLBACK="false"

# OAuth Token Encryption & Browser-Binding Cookie Signing Secrets (mandatory in production for GitHub OAuth)
# Generate with: openssl rand -hex 32
CONNECTOR_TOKEN_ENCRYPTION_KEY=""
OAUTH_STATE_COOKIE_SECRET=""

# GitHub Webhook & Connector Security (GITHUB_WEBHOOK_SECRET mandatory for webhook ingestion)
GITHUB_WEBHOOK_SECRET=""
# Optional comma-separated allowlist of owner/repo permitted to trigger webhook ingestion
GITHUB_ALLOWED_REPOS=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GITHUB_PERSONAL_ACCESS_TOKEN=""

# Slack Events Webhook HMAC-SHA256 Signing Secret (mandatory for POST /api/slack/events)
SLACK_SIGNING_SECRET=""

# Optional Upstash Redis REST Credentials for Distributed Rate-Limiting
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
