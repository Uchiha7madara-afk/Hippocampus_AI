# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Cloud SQL Runtime Environment Variables (injected automatically by AI Studio)
SQL_HOST="localhost"
SQL_DB_NAME="postgres"
SQL_USER="app_user"
SQL_PASSWORD=""
SQL_ADMIN_USER="postgres"
SQL_ADMIN_PASSWORD=""

# Optional Slack Signing Secret for external Slack Webhook verification
SLACK_SIGNING_SECRET=""

# Optional Upstash Redis REST Credentials for Distributed Rate-Limiting
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Default Workspace RBAC Clearance ('Admin' | 'Manager' | 'Engineer')
DEFAULT_RBAC_ROLE="Admin"

# Phase 4: Optional GitHub OAuth & Webhook Connector Credentials
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GITHUB_WEBHOOK_SECRET=""
GITHUB_PERSONAL_ACCESS_TOKEN=""
